{
  "name": "media-viewer",
  "version": "0.13.2",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx tests/workspace-ui.ts",
    "postinstall": "install-electron",
    "test:workspace": "tsx tests/workspace-ui.ts",
    "format": "prettier --write \"{src,shared,electron,tests,scripts}/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"{src,shared,electron,tests,scripts}/**/*.{ts,tsx,mjs}\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@videojs/react": "10.2.0",
    "@xyflow/react": "^12.12.0",
    "music-metadata": "^12.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
